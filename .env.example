# ============================================================================
# 招聘 Agent Demo — LLM 配置
# 用法：复制本文件为 .env（同目录），填好后启动 Streamlit 会自动读取
#   cp .env.example .env
# ============================================================================

# ---------- 方案 A：ChatGPT 官方 API（需能访问 api.openai.com）----------
# key 在这里申请：https://platform.openai.com/api-keys
# 注意：ChatGPT Plus/Pro 订阅费 ≠ API 费用，API 是按 token 单独计费的
OPENAI_API_KEY=sk-你的key
OPENAI_MODEL=gpt-4o-mini
# 官方可留空，程序默认 https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 方案 B：中转网关（国内最省事）----------
# 把 base_url 换成中转商给的地址，key 用中转商发的
# OPENAI_BASE_URL=https://你的中转域名/v1
# OPENAI_API_KEY=sk-中转商的key
# OPENAI_MODEL=gpt-4o-mini

# ---------- 方案 C：非 OpenAI 模型（DeepSeek / Qwen / 内部网关）----------
# 只要兼容 OpenAI 协议就能用，改这两行即可
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ---------- 国内直连官方时的代理（可选）----------
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
